                            <button onclick="launchApp('taskmgr')" style="margin-top:8px;">⟳ Обновить</button>
                        `;
                        w = 520;
                        h = 380;
                        break;
                    case 'mycomputer':
                        title = '🖥️ Мой компьютер';
                        content = createMyComputerContent();
                        w = 560;
                        h = 520;
                        break;
                    case 'regedit':
                        title = '📋 Редактор реестра';
                        const regData = `
                            <div class="reg-tree">
                                <div>📁 <span class="folder">HKEY_LOCAL_MACHINE</span></div>
