<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Windows на JavaScript</title>
    <style>
        /* ----- Глобальный сброс и фон ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            background: #0a0e1a;
        }

        /* ----- ЭКРАН ЗАГРУЗКИ (BOOT SCREEN) ----- */
        #bootScreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #0a0e1a;
            z-index: 999999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 1s ease, transform 1s ease;
        }

        #bootScreen.hidden {
            opacity: 0;
            transform: scale(1.1);
            pointer-events: none;
        }

        .boot-logo {
            font-size: 72px;
            margin-bottom: 20px;
            animation: pulse 1.5s ease-in-out infinite;
        }

        @keyframes pulse {
            0%,
            100% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.08);
                opacity: 0.7;
            }
        }

        .boot-title {
            font-size: 42px;
            font-weight: 300;
            color: #ecf5ff;
            letter-spacing: 4px;
            text-shadow: 0 0 40px rgba(60, 140, 255, 0.15);
        }

        .boot-subtitle {
            font-size: 16px;
            color: #6a8aaa;
            margin-top: 8px;
            letter-spacing: 2px;
            font-weight: 300;
        }

        .boot-progress-container {
            margin-top: 40px;
            width: 380px;
            max-width: 80vw;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 30px;
            height: 6px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .boot-progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #2a6a8a, #6ab0ff);
            border-radius: 30px;
            transition: width 0.3s ease;
        }

        .boot-status {
            color: #6a8aaa;
            font-size: 14px;
            margin-top: 16px;
            font-family: 'Courier New', monospace;
            letter-spacing: 0.5px;
        }

        .boot-status .highlight {
            color: #ffd966;
        }

        .boot-dots {
            display: inline-block;
            width: 20px;
            text-align: left;
        }

        /* ----- ЭКРАН БЛОКИРОВКИ ----- */
        #lockScreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(ellipse at 50% 40%, #2a3f6a, #0a0e1a);
            z-index: 99999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.8s ease, transform 0.8s ease;
            opacity: 0;
            transform: scale(0.95);
            pointer-events: none;
        }

        #lockScreen.visible {
            opacity: 1;
            transform: scale(1);
            pointer-events: auto;
        }

        .lock-time {
            font-size: 82px;
            font-weight: 300;
            color: #ecf5ff;
            text-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
            letter-spacing: 2px;
        }

        .lock-date {
            font-size: 24px;
            color: #b0ccf0;
            margin-top: 8px;
            font-weight: 300;
            text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
        }

        .lock-user {
            margin-top: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .lock-avatar {
            font-size: 72px;
            filter: drop-shadow(0 8px 30px rgba(0, 0, 0, 0.5));
        }

        .lock-username {
            font-size: 22px;
            color: #dce7fc;
            font-weight: 400;
        }

        .lock-input-container {
            margin-top: 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            width: 320px;
        }

        .lock-password-input {
            background: rgba(255, 255, 255, 0.06);
            border: 2px solid rgba(255, 255, 255, 0.15);
            border-radius: 40px;
            padding: 14px 24px;
            width: 100%;
            font-size: 18px;
            color: #ecf5ff;
            outline: none;
            transition: 0.3s;
            text-align: center;
            letter-spacing: 6px;
            font-weight: 500;
        }

        .lock-password-input:focus {
            border-color: #6a9ed0;
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 30px rgba(60, 140, 255, 0.15);
        }

        .lock-password-input::placeholder {
            color: rgba(255, 255, 255, 0.25);
            letter-spacing: 1px;
            font-weight: 300;
        }

        .lock-error {
            color: #ff6b6b;
            font-size: 14px;
            min-height: 24px;
            font-weight: 400;
            opacity: 0;
            transition: 0.3s;
        }

        .lock-error.show {
            opacity: 1;
        }

        .lock-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 40px;
            padding: 12px 48px;
            color: #ecf5ff;
            font-size: 17px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.25s;
            width: 100%;
        }

        .lock-btn:hover {
            background: rgba(60, 140, 255, 0.2);
            border-color: #6a9ed0;
            transform: scale(1.02);
        }

        .lock-btn:active {
            transform: scale(0.96);
        }

        .lock-hint {
            color: rgba(255, 255, 255, 0.2);
            font-size: 13px;
            margin-top: 4px;
        }

        /* ----- РАБОЧИЙ СТОЛ ----- */
        #desktop {
            width: 100vw;
            height: 100vh;
            background: radial-gradient(ellipse at 30% 20%, #2a3f5e, #0e1422);
            position: relative;
            overflow: hidden;
            opacity: 0;
            transition: opacity 1s ease;
        }

        #desktop.visible {
            opacity: 1;
        }

        /* ----- ИКОНКИ РАБОЧЕГО СТОЛА ----- */
        .desktop-icon {
            position: absolute;
            width: 80px;
            height: 90px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #ecf5ff;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
            cursor: pointer;
            border-radius: 12px;
            padding: 6px 4px;
            transition: 0.12s;
            background: rgba(0, 0, 0, 0.1);
            border: 1px solid transparent;
            text-align: center;
            gap: 4px;
        }

        .desktop-icon:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(255, 255, 255, 0.12);
            transform: scale(1.04);
        }

        .desktop-icon .icon-emoji {
            font-size: 44px;
            line-height: 1.2;
            filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.6));
        }

        .desktop-icon .icon-label {
            font-size: 13px;
            font-weight: 500;
            background: rgba(0, 0, 0, 0.45);
            padding: 2px 12px;
            border-radius: 30px;
            backdrop-filter: blur(6px);
            max-width: 90px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ----- ПАНЕЛЬ ЗАДАЧ (TASKBAR) ----- */
        #taskbar {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 56px;
            background: rgba(16, 24, 40, 0.88);
            backdrop-filter: blur(16px);
            display: flex;
            align-items: center;
            padding: 0 16px;
            gap: 12px;
            border-top: 1px solid #3e5270;
            box-shadow: 0 -6px 30px rgba(0, 0, 0, 0.6);
            z-index: 1000;
        }

        #start-btn {
            background: #2a3d5e;
            border: none;
            color: #ecf4ff;
            font-weight: 600;
            font-size: 17px;
            padding: 6px 20px;
            border-radius: 30px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.2s;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
            letter-spacing: 0.3px;
        }

        #start-btn:hover {
            background: #3e5a7c;
            transform: scale(1.02);
        }

        #start-btn:active {
            transform: scale(0.95);
        }

        #task-list {
            display: flex;
            flex: 1;
            gap: 6px;
            overflow-x: auto;
            padding: 4px 0;
            align-items: center;
        }

        .task-item {
            background: rgba(60, 85, 120, 0.35);
            backdrop-filter: blur(4px);
            padding: 4px 16px;
            border-radius: 20px;
            color: #d3e2ff;
            font-size: 14px;
            cursor: pointer;
            white-space: nowrap;
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: 0.15s;
            height: 32px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .task-item:hover {
            background: rgba(80, 120, 180, 0.45);
            border-color: #6a8fc0;
        }

        .task-item.active {
            background: #3e6a9e;
            border-color: #8bb8ff;
            color: white;
            box-shadow: 0 0 16px #3f7ec0;
        }

        #clock {
            color: #cddfff;
            font-size: 15px;
            font-weight: 500;
            background: rgba(0, 0, 0, 0.25);
            padding: 6px 18px;
            border-radius: 30px;
            backdrop-filter: blur(4px);
            border: 1px solid #3a5070;
            white-space: nowrap;
        }

        /* ----- МЕНЮ ПУСК ----- */
        #start-menu {
            position: absolute;
            bottom: 70px;
            left: 16px;
            background: rgba(14, 22, 40, 0.94);
            backdrop-filter: blur(30px);
            border: 1px solid #4f6a8a;
            border-radius: 24px;
            padding: 18px 20px;
            width: 290px;
            color: #dce7fc;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
            z-index: 2000;
            display: none;
            transition: 0.2s;
        }

        #start-menu.visible {
            display: block;
        }

        #start-menu h3 {
            font-weight: 400;
            border-bottom: 1px solid #3a5070;
            padding-bottom: 12px;
            margin-bottom: 14px;
            color: #b6d0f5;
            letter-spacing: 0.5px;
            font-size: 18px;
        }

        .start-app-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 14px;
            border-radius: 18px;
            cursor: pointer;
            transition: 0.12s;
            margin-bottom: 2px;
        }

        .start-app-item:hover {
            background: rgba(70, 110, 170, 0.3);
            backdrop-filter: blur(8px);
        }

        .start-app-item .emoji {
            font-size: 28px;
        }

        .start-app-item span:last-child {
            font-size: 16px;
        }

        .start-divider {
            border: none;
            border-top: 1px solid #3a5070;
            margin: 12px 0;
        }

        /* ----- ОКНА ----- */
        .window {
            position: absolute;
            background: rgba(22, 32, 50, 0.94);
            backdrop-filter: blur(20px);
            border: 1px solid #48638a;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
            min-width: 300px;
            min-height: 180px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            resize: both;
            animation: fadeIn 0.2s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.94) translateY(10px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .window-header {
            background: rgba(8, 16, 30, 0.7);
            padding: 10px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: grab;
            border-bottom: 1px solid #3a5070;
            backdrop-filter: blur(8px);
        }

        .window-header:active {
            cursor: grabbing;
        }

        .window-title {
            color: #eaf3ff;
            font-weight: 600;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .window-controls {
            display: flex;
            gap: 8px;
        }

        .window-controls button {
            background: transparent;
            border: none;
            color: #b0caf0;
            font-size: 18px;
            cursor: pointer;
            width: 28px;
            height: 28px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.15s;
        }

        .window-controls button:hover {
            background: rgba(255, 255, 255, 0.08);
            color: white;
        }

        .window-controls .btn-close:hover {
            background: #c42b3a;
            color: white;
        }

        .window-body {
            flex: 1;
            padding: 18px 22px;
            color: #dce7fc;
            overflow: auto;
            font-size: 15px;
            line-height: 1.6;
            background: rgba(0, 0, 0, 0.12);
            display: flex;
            flex-direction: column;
        }

        .window-body p {
            margin-bottom: 10px;
        }

        .window-body button {
            background: #2d4b70;
            border: none;
            color: white;
            padding: 8px 22px;
            border-radius: 30px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.15s;
            border: 1px solid #4d74a0;
        }

        .window-body button:hover {
            background: #3f6a96;
            transform: scale(1.02);
        }

        .window-body button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .window-body textarea {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid #3a5270;
            border-radius: 10px;
            color: #e8f0ff;
            padding: 12px;
            font-size: 14px;
            resize: vertical;
            font-family: 'Courier New', monospace;
            outline: none;
            min-height: 120px;
        }

        .window-body textarea:focus {
            border-color: #6a9ed0;
            box-shadow: 0 0 20px #2f5580;
        }

        .resize-handle {
            position: absolute;
            bottom: 4px;
            right: 4px;
            width: 16px;
            height: 16px;
            cursor: nwse-resize;
            border-bottom: 3px solid #6480aa;
            border-right: 3px solid #6480aa;
            border-radius: 0 0 8px 0;
            opacity: 0.4;
        }

        /* ----- СТИЛИ ДЛЯ БРАУЗЕРА ----- */
        .browser-toolbar {
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: rgba(0, 0, 0, 0.2);
            padding: 10px 12px;
            border-radius: 10px;
            border: 1px solid #2a4060;
            margin-bottom: 10px;
            flex-shrink: 0;
        }

        .browser-nav {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .browser-nav button {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #2a4060;
            color: #b0caf0;
            padding: 4px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            transition: 0.15s;
            min-width: 32px;
        }

        .browser-nav button:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: #4a6a8a;
        }

        .browser-nav button:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .browser-url {
            flex: 1;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid #2a4060;
            border-radius: 20px;
            padding: 6px 16px;
            color: #ecf5ff;
            font-size: 14px;
            outline: none;
            min-width: 120px;
        }

        .browser-url:focus {
            border-color: #6a9ed0;
            box-shadow: 0 0 20px rgba(60, 140, 255, 0.1);
        }

        .browser-url::placeholder {
            color: rgba(255, 255, 255, 0.25);
        }

        .browser-content {
            flex: 1;
            background: rgba(0, 0, 0, 0.15);
            border-radius: 10px;
            border: 1px solid #2a4060;
            overflow: hidden;
            min-height: 200px;
            position: relative;
        }

        .browser-content iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: white;
        }

        .browser-content .iframe-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: #8aaac0;
            padding: 40px;
            text-align: center;
        }

        .browser-content .iframe-placeholder .big-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }

        .browser-content .iframe-placeholder .title {
            font-size: 20px;
            color: #ecf5ff;
            margin-bottom: 8px;
        }

        .browser-content .iframe-placeholder .subtitle {
            font-size: 14px;
            color: #6a8aaa;
        }

        .browser-status {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #6a8aaa;
            padding: 4px 4px 0 4px;
            font-family: 'Courier New', monospace;
            flex-shrink: 0;
        }

        .browser-status .loading-text {
            color: #ffd966;
        }

        .browser-status .success-text {
            color: #6a8a6a;
        }

        .browser-status .error-text {
            color: #ff6b6b;
        }

        .browser-tabs {
            display: flex;
            gap: 4px;
            padding: 4px 0;
            overflow-x: auto;
            flex-shrink: 0;
        }

        .browser-tab {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #2a4060;
            border-radius: 8px 8px 0 0;
            padding: 4px 14px;
            font-size: 13px;
            color: #8aaac0;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            transition: 0.15s;
            border-bottom: none;
        }

        .browser-tab.active {
            background: rgba(255, 255, 255, 0.1);
            color: #ecf5ff;
            border-color: #4a6a8a;
        }

        .browser-tab:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .browser-tab .tab-close {
            cursor: pointer;
            opacity: 0.5;
            transition: 0.15s;
            font-size: 14px;
        }

        .browser-tab .tab-close:hover {
            opacity: 1;
            color: #ff6b6b;
        }

        .browser-tab .tab-favicon {
            font-size: 14px;
        }

        .browser-tab .tab-loading {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }

        /* ----- СТИЛИ ДЛЯ РЕДАКТОРА РЕЕСТРА ----- */
        .reg-tree {
            font-family: 'Courier New', monospace;
            font-size: 14px;
            color: #b0d0ff;
            background: rgba(0, 0, 0, 0.25);
            padding: 12px;
            border-radius: 10px;
            min-height: 150px;
            border: 1px solid #3a5270;
        }

        .reg-tree .folder {
            color: #ffd966;
        }

        .reg-tree .key {
            color: #7fc9ff;
        }

        .reg-tree .value {
            color: #a8e6a8;
        }

        .reg-tree .indent {
            padding-left: 24px;
        }

        /* ----- ТАБЛИЦА ДЛЯ ДИСПЕТЧЕРА ----- */
        .taskmgr-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            color: #dce7fc;
        }

        .taskmgr-table th {
            text-align: left;
            padding: 8px 10px;
            border-bottom: 2px solid #3a5270;
            color: #b0caf0;
            font-weight: 500;
        }

        .taskmgr-table td {
            padding: 6px 10px;
            border-bottom: 1px solid #2a4060;
        }

        .taskmgr-table .cpu-bar {
            display: inline-block;
            height: 8px;
            border-radius: 10px;
            background: #3e6a9e;
            transition: 0.3s;
        }

        /* ----- СТИЛИ ДЛЯ МОЕГО КОМПЬЮТЕРА ----- */
        .drive-container {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 12px;
            padding: 14px 16px;
            margin-bottom: 12px;
            border: 1px solid #2a4060;
        }

        .drive-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

        .drive-name {
            font-weight: 600;
            color: #b0d0ff;
        }

        .drive-size {
            font-size: 13px;
            color: #8aaac0;
        }

        .drive-bar {
            width: 100%;
            height: 20px;
            background: #0a1422;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2a4060;
            position: relative;
        }

        .drive-bar-fill {
            height: 100%;
            border-radius: 12px;
            transition: width 0.8s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            color: white;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
        }

        .drive-bar-fill.scanning {
            background: repeating-linear-gradient(90deg,
                    #2a6a8a,
                    #2a6a8a 10px,
                    #3a8aaa 10px,
                    #3a8aaa 20px);
            animation: scan 0.8s linear infinite;
        }

        @keyframes scan {
            0% {
                background-position: 0 0;
            }
            100% {
                background-position: 40px 0;
            }
        }

        .scan-status {
            margin-top: 6px;
            font-size: 13px;
            color: #8aaac0;
            font-family: 'Courier New', monospace;
        }

        .scan-status .highlight {
            color: #ffd966;
        }

        .drive-details {
            margin-top: 8px;
            font-size: 13px;
            color: #8aaac0;
            display: grid;
