                                const pctNew = Math.round((usedNew / totalNew) * 100);
                                const freeNew = totalNew - usedNew;

                                if (driveBar) {
                                    driveBar.style.width = pctNew + '%';
                                    driveBar.textContent = pctNew + '%';
                                    driveBar.style.background = pctNew > 80 ? '#c42b3a' : '#3e8a5e';
                                }

                                const sizeSpan = document.querySelector('.drive-size');
                                if (sizeSpan) {
                                    sizeSpan.textContent = `${usedNew} GB / ${totalNew} GB`;
                                }

                                const details = document.querySelectorAll('.drive-details .value');
                                if (details.length >= 2) {
                                    details[0].textContent = `${usedNew} GB`;
                                    details[1].textContent = `${freeNew} GB`;
