                                else if (cmd === 'explorer') response = '📁 Запустите Проводник через Пуск';
                                else if (cmd === 'taskmgr') response = '📊 Запустите Диспетчер задач через Пуск';
                                else if (cmd === 'mycomputer') response = '🖥️ Запустите Мой компьютер через Пуск';
                                else if (cmd === 'regedit') response = '📋 Запустите Редактор реестра через Пуск';
                                else if (cmd === 'browser') response = '🌐 Запустите Браузер через Пуск';
