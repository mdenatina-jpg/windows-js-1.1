                <span class="emoji">📝</span><span>Блокнот</span>
            </div>
            <div class="start-app-item" data-app="about">
                <span class="emoji">ℹ️</span><span>О системе</span>
            </div>
            <div class="start-app-item" data-app="explorer">
                <span class="emoji">📁</span><span>Проводник</span>
            </div>
            <div class="start-app-item" data-app="terminal">
                <span class="emoji">⌨️</span><span>Терминал</span>
