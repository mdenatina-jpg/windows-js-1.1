    <script>
        (function() {
            'use strict';

            // ----- СОСТОЯНИЕ -----
            const state = {
                windows: [],
                nextId: 1,
                activeWindowId: null,
                startMenuOpen: false,
                isLocked: true,
                bootComplete: false,
                browserHistory: {},
            };

            // DOM
            const desktop = document.getElementById('desktop');
            const taskList = document.getElementById('task-list');
            const startBtn = document.getElementById('start-btn');
            const startMenu = document.getElementById('start-menu');
            const clockEl = document.getElementById('clock');

            // Boot screen
            const bootScreen = document.getElementById('bootScreen');
            const bootProgress = document.getElementById('bootProgress');
            const bootStatus = document.getElementById('bootStatus');
            const bootDots = document.getElementById('bootDots');

            // Lock screen
            const lockScreen = document.getElementById('lockScreen');
            const lockTime = document.getElementById('lockTime');
            const lockDate = document.getElementById('lockDate');
            const lockPassword = document.getElementById('lockPassword');
            const lockError = document.getElementById('lockError');
            const lockSubmit = document.getElementById('lockSubmit');
            const lockBtn = document.getElementById('lock-btn');

            // ----- ЧАСЫ -----
            function updateClock() {
                const d = new Date();
                const time = d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
                clockEl.textContent = time;
                if (lockTime) lockTime.textContent = time;
                if (lockDate) {
                    const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
                    lockDate.textContent = d.toLocaleDateString('ru-RU', options);
                }
            }
            updateClock();
            setInterval(updateClock, 10000);

            // ----- ЭКРАН ЗАГРУЗКИ -----
            function bootSystem() {
                let progress = 0;
                const statusMessages = [
                    'Загрузка ядра системы...',
                    'Инициализация модулей...',
                    'Подключение служб...',
                    'Загрузка драйверов...',
                    'Проверка оборудования...',
                    'Настройка окружения...',
                    'Загрузка пользовательского интерфейса...',
                    'Подготовка рабочего стола...',
                    'Система готова к работе!'
                ];

                let msgIndex = 0;
                let dotCount = 0;

                const bootInterval = setInterval(() => {
                    progress += 1 + Math.floor(Math.random() * 4);

                    if (progress >= 100) {
                        progress = 100;
                        clearInterval(bootInterval);
                        bootProgress.style.width = '100%';
                        bootStatus.innerHTML = '<span class="highlight">✅</span> Загрузка завершена!';

                        setTimeout(() => {
                            bootScreen.classList.add('hidden');
                            desktop.classList.add('visible');

                            setTimeout(() => {
                                lockScreen.classList.add('visible');
                                state.isLocked = true;
                                lockPassword.focus();

                                setTimeout(() => {
                                    launchApp('about');
                                    setTimeout(() => launchApp('mycomputer'), 400);
                                    setTimeout(() => launchApp('browser'), 800);
                                }, 200);

                            }, 400);

                        }, 600);

                        return;
                    }

                    bootProgress.style.width = progress + '%';

                    if (progress > 10 && msgIndex < statusMessages.length - 1) {
                        const threshold = Math.floor(10 + (90 / (statusMessages.length - 1)) * msgIndex);
                        if (progress >= threshold && msgIndex < statusMessages.length - 1) {
                            msgIndex++;
                            bootStatus.innerHTML =
                                `<span class="highlight">▶</span> ${statusMessages[msgIndex]} <span class="boot-dots" id="bootDots"></span>`;
                        }
                    }

                    dotCount = (dotCount + 1) % 4;
                    const dots = '.'.repeat(dotCount) + ' '.repeat(3 - dotCount);
                    const dotsEl = document.getElementById('bootDots');
                    if (dotsEl) dotsEl.textContent = dots;

                }, 150);
            }

            setTimeout(bootSystem, 300);

            // ----- ЭКРАН БЛОКИРОВКИ -----
            function lockSystem() {
                if (!state.bootComplete) return;
                state.isLocked = true;
                lockScreen.classList.add('visible');
                lockPassword.value = '';
                lockError.classList.remove('show');
                lockPassword.focus();
                state.windows.forEach(w => {
                    w.element.style.display = 'none';
                });
                updateTaskbar();
            }

            function unlockSystem() {
                state.isLocked = false;
                lockScreen.classList.remove('visible');
                state.windows.forEach(w => {
                    w.element.style.display = 'flex';
                });
                if (state.activeWindowId) {
                    const win = state.windows.find(w => w.id === state.activeWindowId);
                    if (win) setActiveWindow(state.activeWindowId);
                } else if (state.windows.length > 0) {
                    setActiveWindow(state.windows[state.windows.length - 1].id);
                }
                updateTaskbar();
            }

            function checkPassword() {
                const pass = lockPassword.value;
                if (pass === '1234') {
                    unlockSystem();
                } else {
                    lockError.classList.add('show');
                    lockPassword.value = '';
                    lockPassword.focus();
                    setTimeout(() => {
                        lockError.classList.remove('show');
                    }, 2000);
                }
            }

            lockPassword.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkPassword();
                }
            });

            lockSubmit.addEventListener('click', checkPassword);

            lockBtn.addEventListener('click', () => {
                if (!state.isLocked && state.bootComplete) {
                    lockSystem();
                }
            });

            // ----- ВСПОМОГАТЕЛЬНЫЕ -----
            function getNextId() { return state.nextId++; }

            // ----- ОБНОВЛЕНИЕ ПАНЕЛИ ЗАДАЧ -----
            function updateTaskbar() {
                taskList.innerHTML = '';
                state.windows.forEach(w => {
                    const el = w.element;
                    if (el.style.display === 'none') return;
                    const btn = document.createElement('div');
                    btn.className = 'task-item';
                    if (state.activeWindowId === w.id && !state.isLocked) btn.classList.add('active');
                    btn.textContent = w.title;
                    btn.addEventListener('click', () => {
                        if (state.isLocked) return;
                        if (el.style.display === 'none') el.style.display = 'flex';
                        setActiveWindow(w.id);
                        el.style.zIndex = 100 + state.windows.length;
                    });
                    taskList.appendChild(btn);
                });
            }

            // ----- АКТИВАЦИЯ ОКНА -----
            function setActiveWindow(id) {
                if (state.isLocked) return;
                state.activeWindowId = id;
                state.windows.forEach(w => {
                    const el = w.element;
                    if (w.id === id) {
                        el.style.zIndex = 100 + state.windows.length;
                        el.style.borderColor = '#7aa9e6';
                        el.style.boxShadow = '0 20px 60px rgba(0,0,0,0.8), 0 0 30px rgba(60,140,255,0.15)';
                    } else {
                        el.style.borderColor = '#48638a';
                        el.style.boxShadow = '0 12px 40px rgba(0,0,0,0.5)';
                    }
                });
                updateTaskbar();
            }

            // ----- ЗАКРЫТИЕ ОКНА -----
            function closeWindow(id) {
                const idx = state.windows.findIndex(w => w.id === id);
                if (idx === -1) return;
                const winData = state.windows[idx];
                winData.element.remove();
                state.windows.splice(idx, 1);
                if (state.activeWindowId === id) {
                    state.activeWindowId = null;
                    const visible = state.windows.find(w => w.element.style.display !== 'none');
                    if (visible) setActiveWindow(visible.id);
                }
                updateTaskbar();
            }

            // ----- СОЗДАНИЕ ОКНА -----
            function createWindow(app, title, contentHTML, width = 420, height = 280) {
                const id = getNextId();
                const win = document.createElement('div');
                win.className = 'window';
                win.dataset.windowId = id;

                const offset = state.windows.length * 24;
                win.style.left = (60 + offset) + 'px';
                win.style.top = (40 + offset) + 'px';
                win.style.width = width + 'px';
                win.style.height = height + 'px';

                const header = document.createElement('div');
                header.className = 'window-header';
                header.innerHTML = `
                    <span class="window-title">${title}</span>
                    <div class="window-controls">
                        <button class="btn-minimize" title="Свернуть">─</button>
                        <button class="btn-close" title="Закрыть">✕</button>
                    </div>
                `;

                const body = document.createElement('div');
                body.className = 'window-body';
                body.innerHTML = contentHTML;

                win.appendChild(header);
                win.appendChild(body);

                const resizeHandle = document.createElement('div');
                resizeHandle.className = 'resize-handle';
                win.appendChild(resizeHandle);

                desktop.appendChild(win);

                const winData = {
                    id,
                    app,
                    title,
                    element: win,
                    content: body,
                    width,
                    height,
                    x: parseInt(win.style.left),
                    y: parseInt(win.style.top),
                };
                state.windows.push(winData);

                if (!state.isLocked) {
                    setActiveWindow(id);
                } else {
                    win.style.display = 'none';
                }

                // ----- СОБЫТИЯ -----
                header.querySelector('.btn-close').addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeWindow(id);
                });

                header.querySelector('.btn-minimize').addEventListener('click', (e) => {
                    e.stopPropagation();
                    win.style.display = 'none';
                    updateTaskbar();
                    if (state.activeWindowId === id) {
                        state.activeWindowId = null;
                        const visible = state.windows.find(w => w.element.style.display !== 'none');
                        if (visible) setActiveWindow(visible.id);
                    }
                });

                let drag = false,
                    startX, startY, origX, origY;
                header.addEventListener('mousedown', (e) => {
                    if (state.isLocked) return;
                    if (e.target.closest('.window-controls')) return;
                    drag = true;
                    const rect = win.getBoundingClientRect();
                    startX = e.clientX;
                    startY = e.clientY;
                    origX = rect.left;
                    origY = rect.top;
                    win.style.cursor = 'grabbing';
                    setActiveWindow(id);
                    e.preventDefault();
                });

                window.addEventListener('mousemove', (e) => {
                    if (!drag) return;
                    const dx = e.clientX - startX;
                    const dy = e.clientY - startY;
                    win.style.left = (origX + dx) + 'px';
                    win.style.top = (origY + dy) + 'px';
                    const data = state.windows.find(w => w.id === id);
                    if (data) { data.x = origX + dx;
                        data.y = origY + dy; }
                });

                window.addEventListener('mouseup', () => {
                    if (drag) { drag = false;
                        win.style.cursor = 'default'; }
                });

                let resize = false,
                    rStartX, rStartY, rOrigW, rOrigH;
                resizeHandle.addEventListener('mousedown', (e) => {
                    if (state.isLocked) return;
                    e.stopPropagation();
                    resize = true;
                    rStartX = e.clientX;
                    rStartY = e.clientY;
                    rOrigW = win.offsetWidth;
                    rOrigH = win.offsetHeight;
                    e.preventDefault();
                });

                window.addEventListener('mousemove', (e) => {
                    if (!resize) return;
                    const dw = e.clientX - rStartX;
                    const dh = e.clientY - rStartY;
                    win.style.width = Math.max(260, rOrigW + dw) + 'px';
                    win.style.height = Math.max(150, rOrigH + dh) + 'px';
                });

                window.addEventListener('mouseup', () => { resize = false; });

                win.addEventListener('mousedown', () => {
                    if (!state.isLocked) setActiveWindow(id);
                });

                updateTaskbar();
                return winData;
            }

            // ----- ГЕНЕРАТОР СЛУЧАЙНЫХ ДАННЫХ ДЛЯ ДИСПЕТЧЕРА -----
            function generateProcesses() {
                const names = ['System', 'svchost.exe', 'explorer.exe', 'chrome.exe', 'firefox.exe', 'notepad.exe',
                    'cmd.exe', 'taskmgr.exe', 'winlogon.exe', 'services.exe', 'lsass.exe', 'spoolsv.exe',
                    'SearchIndexer.exe', 'RuntimeBroker.exe', 'ShellExperienceHost.exe', 'browser.exe'
                ];
                const processes = [];
                const count = 8 + Math.floor(Math.random() * 12);
                const used = new Set();
                for (let i = 0; i < Math.min(count, names.length); i++) {
                    let name;
                    do {
                        name = names[Math.floor(Math.random() * names.length)];
                    } while (used.has(name));
                    used.add(name);
                    const cpu = Math.floor(Math.random() * 60) + 1;
                    const memory = Math.floor(Math.random() * 500) + 20;
                    processes.push({ name, cpu, memory, pid: 1000 + Math.floor(Math.random() * 9000) });
                }
                return processes;
            }

            // ----- РЕАЛИСТИЧНЫЙ МОЙ КОМПЬЮТЕР СО СКАНИРОВАНИЕМ ДИСКА -----
            function createMyComputerContent() {
                const totalDisk = 512;
                const usedDisk = 187 + Math.floor(Math.random() * 40);
                const freeDisk = totalDisk - usedDisk;
                const diskPercent = Math.round((usedDisk / totalDisk) * 100);

                const fileTypes = ['.txt', '.docx', '.pdf', '.jpg', '.png', '.mp3', '.mp4', '.exe', '.zip', '.js', '.html',
                    '.css'
                ];
                const fileNames = ['report', 'document', 'photo', 'music', 'video', 'archive', 'setup', 'notes', 'project',
                    'backup', 'config', 'data', 'image', 'presentation'
                ];
                let fileList = '';
                for (let i = 0; i < 12 + Math.floor(Math.random() * 15); i++) {
                    const name = fileNames[Math.floor(Math.random() * fileNames.length)];
                    const ext = fileTypes[Math.floor(Math.random() * fileTypes.length)];
                    const size = (Math.random() * 15 + 0.5).toFixed(1);
                    fileList += `📄 ${name}${ext} (${size} MB)\n`;
                }

                return `
                    <div style="margin-bottom:12px;">
                        <div class="system-info-grid">
                            <span><span class="label">💻 Система:</span> <span class="value">Windows JS 3.0</span></span>
                            <span><span class="label">⚙️ Процессор:</span> <span class="value">JS Engine v8</span></span>
                            <span><span class="label">🧠 Память:</span> <span class="value">${(2.4 + Math.random() * 1.2).toFixed(1)} GB</span></span>
                            <span><span class="label">🖥️ Разрядность:</span> <span class="value">64-bit</span></span>
                            <span><span class="label">🌐 Сеть:</span> <span class="value">Ethernet (подключено)</span></span>
                            <span><span class="label">🖨️ Принтер:</span> <span class="value">Не установлен</span></span>
                        </div>
                    </div>

                    <div class="drive-container">
                        <div class="drive-header">
                            <span class="drive-name">📀 Локальный диск (C:)</span>
                            <span class="drive-size">${usedDisk} GB / ${totalDisk} GB</span>
                        </div>
                        <div class="drive-bar">
                            <div class="drive-bar-fill" id="driveBarFill" style="width:${diskPercent}%; background:${diskPercent > 80 ? '#c42b3a' : '#3e8a5e'};">
                                ${diskPercent}%
                            </div>
                        </div>
                        <div class="scan-status" id="scanStatus">
                            <span class="highlight">🟢</span> Готово · Файлов: <span id="fileCount">${12 + Math.floor(Math.random() * 15)}</span>
                        </div>
                        <div class="drive-details">
                            <span><span class="label">📂 Занято:</span> <span class="value">${usedDisk} GB</span></span>
                            <span><span class="label">📂 Свободно:</span> <span class="value">${freeDisk} GB</span></span>
                            <span><span class="label">📁 Файловая система:</span> <span class="value">NTFS</span></span>
                            <span><span class="label">📅 Дата сканирования:</span> <span class="value">${new Date().toLocaleDateString()}</span></span>
                        </div>
                    </div>

                    <div style="display:flex; gap:10px; margin-top:6px; flex-wrap:wrap;">
                        <button id="scanDriveBtn">🔍 Сканировать диск</button>
                        <button id="analyzeBtn">📊 Анализ диска</button>
                        <button id="refreshDrivesBtn">🔄 Обновить</button>
                    </div>

                    <div id="scanLog" style="margin-top:12px; background:rgba(0,0,0,0.2); border-radius:8px; padding:10px 14px; font-family:'Courier New', monospace; font-size:13px; max-height:120px; overflow-y:auto; color:#8aaac0; border:1px solid #2a4060; display:none;">
                        <div style="color:#ffd966;">▶ Инициализация сканирования...</div>
                    </div>

                    <div id="fileList" style="margin-top:10px; background:rgba(0,0,0,0.15); border-radius:8px; padding:10px 14px; font-family:'Courier New', monospace; font-size:12px; max-height:100px; overflow-y:auto; color:#8aaac0; border:1px solid #2a4060; display:none; white-space:pre-wrap;">
                        ${fileList}
                    </div>

                    <p style="margin-top:12px; font-size:13px; opacity:0.5;">🔄 Данные обновлены (${new Date().toLocaleTimeString()})</p>
                `;
            }

            // ----- РЕАЛИСТИЧНЫЙ БРАУЗЕР С IFrame -----
            function createBrowserContent() {
                // Инициализация истории браузера
                if (!state.browserHistory.tabs) {
                    state.browserHistory.tabs = [{
                        id: 1,
                        title: 'Новая вкладка',
                        url: '',
                        history: [''],
                        historyIndex: 0,
                        favicon: '🌐',
                        isLoading: false,
                    }];
                    state.browserHistory.nextTabId = 2;
                    state.browserHistory.activeTabId = 1;
                }

                let tabsHTML = '';
                state.browserHistory.tabs.forEach(tab => {
                    const isActive = tab.id === state.browserHistory.activeTabId;
                    const loadingClass = tab.isLoading ? 'tab-loading' : '';
                    tabsHTML += `
                        <div class="browser-tab ${isActive ? 'active' : ''}" data-tab-id="${tab.id}">
                            <span class="tab-favicon ${loadingClass}">${tab.isLoading ? '⟳' : (tab.favicon || '🌐')}</span>
                            <span>${tab.title || 'Новая вкладка'}</span>
                            <span class="tab-close" data-tab-id="${tab.id}">✕</span>
                        </div>
                    `;
                });

                const activeTab = state.browserHistory.tabs.find(t => t.id === state.browserHistory.activeTabId);
                const currentUrl = activeTab ? activeTab.url : '';

                return `
                    <div class="browser-toolbar">
                        <div class="browser-tabs">
                            ${tabsHTML}
                            <button id="newTabBtn" style="background:rgba(255,255,255,0.05); border:1px solid #2a4060; color:#b0caf0; border-radius:8px; padding:2px 12px; cursor:pointer; font-size:16px;">+</button>
                        </div>
                        <div class="browser-nav">
                            <button id="backBtn" title="Назад">◀</button>
                            <button id="forwardBtn" title="Вперёд">▶</button>
                            <button id="refreshBtn" title="Обновить">⟳</button>
                            <button id="homeBtn" title="Домой">🏠</button>
                            <input type="text" class="browser-url" id="browserUrl" placeholder="Введите URL (например, https://example.com)..." value="${currentUrl}" />
                            <button id="goBtn">Перейти</button>
                        </div>
                        <div class="browser-status">
                            <span id="browserStatus">Готово</span>
                            <span id="browserTime">${new Date().toLocaleTimeString()}</span>
                        </div>
                    </div>
                    <div class="browser-content" id="browserContent">
                        ${renderIframe(currentUrl)}
                    </div>
                `;
            }

            function renderIframe(url) {
                if (!url || url === '' || url === 'about:blank') {
                    return `
                        <div class="iframe-placeholder">
                            <div class="big-icon">🌐</div>
                            <div class="title">Добро пожаловать в браузер</div>
                            <div class="subtitle">Введите адрес сайта в строку выше</div>
                            <div style="margin-top:20px; color:#4a6a8a; font-size:13px;">
                                Например: https://example.com
                            </div>
                        </div>
                    `;
                }

                // Проверяем, что URL имеет протокол
                let finalUrl = url;
                if (!finalUrl.startsWith('http://') && !finalUrl.startsWith('https://') && !finalUrl.startsWith('file://')) {
                    finalUrl = 'https://' + finalUrl;
                }

                // Для некоторых сайтов, которые блокируют iframe, показываем сообщение
                const blockedSites = ['youtube.com', 'youtu.be', 'google.com', 'facebook.com', 'twitter.com', 'instagram.com',
                    'tiktok.com'
                ];
                const isBlocked = blockedSites.some(site => finalUrl.includes(site));

                if (isBlocked) {
                    return `
                        <div class="iframe-placeholder" style="justify-content:center; padding:40px;">
                            <div class="big-icon">🔒</div>
                            <div class="title">Сайт не отображается в iframe</div>
                            <div class="subtitle">Некоторые сайты (YouTube, Google, соцсети) блокируют загрузку в iframe</div>
                            <div style="margin-top:16px; color:#6a8aaa; font-size:14px;">
                                Попробуйте открыть в новой вкладке: <span style="color:#6ab0ff;">${finalUrl}</span>
                            </div>
                            <button onclick="window.open('${finalUrl}', '_blank')" style="margin-top:16px; background:#2d4b70; border:none; color:white; padding:10px 28px; border-radius:30px; cursor:pointer; font-weight:500;">
                                🔗 Открыть в новой вкладке
                            </button>
                        </div>
                    `;
                }

                return `
                    <iframe src="${finalUrl}" sandbox="allow-scripts allow-same-origin allow-forms allow-popups" loading="lazy"></iframe>
                `;
            }

            // ----- ЗАПУСК ПРИЛОЖЕНИЙ -----
