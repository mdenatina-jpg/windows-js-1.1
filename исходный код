                }

                const winData = createWindow(appName, title, content, w, h);

                // Специфика для браузера
                if (appName === 'browser') {
                    setTimeout(() => {
                        setupBrowserEvents(winData.id);
                    }, 150);
                }

                // Специфика для "Моего компьютера"
                if (appName === 'mycomputer') {
                    setTimeout(() => {
                        const scanBtn = document.getElementById('scanDriveBtn');
                        const analyzeBtn = document.getElementById('analyzeBtn');
                        const refreshBtn = document.getElementById('refreshDrivesBtn');
                        const scanLog = document.getElementById('scanLog');
                        const fileListEl = document.getElementById('fileList');
                        const driveBar = document.getElementById('driveBarFill');
                        const scanStatus = document.getElementById('scanStatus');
                        const fileCountSpan = document.getElementById('fileCount');

                        if (scanBtn) {
                            scanBtn.addEventListener('click', function() {
                                if (this.disabled) return;
                                this.disabled = true;
                                scanLog.style.display = 'block';
                                scanLog.innerHTML = '<div style="color:#ffd966;">▶ Запуск сканирования диска C:...</div>';

