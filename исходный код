                                        scanLog.innerHTML +=
                                            `<div style="color:#a8e6a8;">✅ Сканирование завершено. Найдено ${finalFiles} файлов.</div>`;
                                        scanLog.innerHTML +=
                                            `<div style="color:#8aaac0;">📊 Общий размер: ${(100 + Math.random() * 150).toFixed(1)} GB</div>`;
                                        scanLog.innerHTML +=
                                            `<div style="color:#8aaac0;">📁 Папок: ${Math.floor(finalFiles * 0.3 + Math.random() * 20)}</div>`;
                                        scanLog.scrollTop = scanLog.scrollHeight;

                                        if (fileListEl) {
                                            fileListEl.style.display = 'block';
                                            let newFileList = '';
                                            const fileTypes2 = ['.txt', '.docx', '.pdf', '.jpg', '.png', '.mp3',
                                                '.mp4', '.exe', '.zip', '.js', '.html', '.css', '.json', '.xml'
                                            ];
                                            const fileNames2 = ['report', 'document', 'photo', 'music', 'video',
                                                'archive', 'setup', 'notes', 'project', 'backup', 'config',
                                                'data', 'image', 'presentation', 'system', 'user', 'temp'
                                            ];
                                            for (let i = 0; i < Math.min(finalFiles, 30); i++) {
                                                const name = fileNames2[Math.floor(Math.random() * fileNames2
                                                .length)];
                                                const ext = fileTypes2[Math.floor(Math.random() * fileTypes2
                                                .length)];
                                                const size = (Math.random() * 15 + 0.5).toFixed(1);
                                                newFileList += `📄 ${name}${ext} (${size} MB)\n`;
                                            }
                                            if (finalFiles > 30) {
                                                newFileList += `\n... и ещё ${finalFiles - 30} файлов`;
                                            }
                                            fileListEl.textContent = newFileList;
                                        }

                                        this.disabled = false;
                                        return;
                                    }

                                    const pct = Math.min(progress, 100);
                                    driveBar.style.width = pct + '%';
                                    driveBar.textContent = pct + '%';
                                    scanStatus.innerHTML =
                                        `<span class="highlight">🔄</span> Сканирование... ${pct}% · Найдено файлов: ${filesFound}`;

                                    if (pct % 15 < 3) {
                                        scanLog.innerHTML +=
                                            `<div style="color:#8aaac0;">📂 Сканирование папок... ${pct}% (найдено ${filesFound} файлов)</div>`;
