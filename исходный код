            // ----- НАСТРОЙКА СОБЫТИЙ БРАУЗЕРА -----
            function setupBrowserEvents(windowId) {
                const urlInput = document.getElementById('browserUrl');
                const goBtn = document.getElementById('goBtn');
                const backBtn = document.getElementById('backBtn');
                const forwardBtn = document.getElementById('forwardBtn');
                const refreshBtn = document.getElementById('refreshBtn');
                const homeBtn = document.getElementById('homeBtn');
                const newTabBtn = document.getElementById('newTabBtn');
                const contentEl = document.getElementById('browserContent');
                const statusEl = document.getElementById('browserStatus');

                if (!urlInput) return;

                function navigateTo(url) {
                    if (!url || url.trim() === '') {
                        url = 'about:blank';
                    }
                    let finalUrl = url.trim();

                    // Если это не URL, добавляем https://
                    if (!finalUrl.startsWith('http://') && !finalUrl.startsWith('https://') && !finalUrl.startsWith(
                            'about:') && !finalUrl.startsWith('file://')) {
                        finalUrl = 'https://' + finalUrl;
                    }

                    const activeTab = state.browserHistory.tabs.find(t => t.id === state.browserHistory.activeTabId);
                    if (!activeTab) return;

                    // Обновляем историю
                    activeTab.history = activeTab.history.slice(0, activeTab.historyIndex + 1);
                    activeTab.history.push(finalUrl);
                    activeTab.historyIndex = activeTab.history.length - 1;
                    activeTab.url = finalUrl;
                    activeTab.isLoading = true;

                    // Обновляем заголовок
                    let title = finalUrl.replace(/^https?:\/\//, '').split('/')[0] || 'Новая вкладка';
                    if (title.length > 25) title = title.substring(0, 25) + '...';
                    activeTab.title = title || 'Новая вкладка';

                    // Обновляем URL в строке
                    urlInput.value = finalUrl;

                    // Показываем загрузку
                    if (statusEl) {
                        statusEl.innerHTML = '<span class="loading-text">⏳ Загрузка...</span>';
                    }

                    // Обновляем вкладки
                    updateBrowserTabs(windowId);

                    // Загружаем iframe
                    if (contentEl) {
                        contentEl.innerHTML = renderIframe(finalUrl);
                    }

                    // Имитация завершения загрузки
                    setTimeout(() => {
                        activeTab.isLoading = false;
                        if (statusEl) {
                            statusEl.innerHTML = '<span class="success-text">✅ Загружено</span>';
                        }
                        // Обновляем заголовок окна
                        const winData = state.windows.find(w => w.id === windowId);
                        if (winData) {
                            const titleEl = winData.element.querySelector('.window-title');
                            if (titleEl) {
                                titleEl.innerHTML = `🌐 ${activeTab.title}`;
                            }
                        }
                        updateBrowserTabs(windowId);
                    }, 600 + Math.random() * 400);
                }

                // Навигация
                window.navigateTo = navigateTo;

                if (goBtn) {
                    goBtn.addEventListener('click', () => {
                        navigateTo(urlInput.value);
                    });
                }

                if (urlInput) {
                    urlInput.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            navigateTo(urlInput.value);
                        }
                    });
                }

                if (backBtn) {
                    backBtn.addEventListener('click', () => {
                        const activeTab = state.browserHistory.tabs.find(t => t.id === state.browserHistory
                        .activeTabId);
                        if (activeTab && activeTab.historyIndex > 0) {
                            activeTab.historyIndex--;
                            const url = activeTab.history[activeTab.historyIndex];
                            activeTab.url = url;
                            urlInput.value = url;
                            if (contentEl) {
                                contentEl.innerHTML = renderIframe(url);
                            }
                            updateBrowserTabs(windowId);
                        }
                    });
                }

                if (forwardBtn) {
                    forwardBtn.addEventListener('click', () => {
                        const activeTab = state.browserHistory.tabs.find(t => t.id === state.browserHistory
                        .activeTabId);
                        if (activeTab && activeTab.historyIndex < activeTab.history.length - 1) {
                            activeTab.historyIndex++;
                            const url = activeTab.history[activeTab.historyIndex];
                            activeTab.url = url;
                            urlInput.value = url;
                            if (contentEl) {
                                contentEl.innerHTML = renderIframe(url);
                            }
                            updateBrowserTabs(windowId);
                        }
                    });
                }

                if (refreshBtn) {
                    refreshBtn.addEventListener('click', () => {
                        const activeTab = state.browserHistory.tabs.find(t => t.id === state.browserHistory
                        .activeTabId);
                        if (activeTab) {
                            navigateTo(activeTab.url);
                        }
                    });
                }

                if (homeBtn) {
                    homeBtn.addEventListener('click', () => {
                        navigateTo('');
                    });
                }

                if (newTabBtn) {
                    newTabBtn.addEventListener('click', () => {
                        const newTab = {
                            id: state.browserHistory.nextTabId++,
                            title: 'Новая вкладка',
                            url: '',
                            history: [''],
                            historyIndex: 0,
                            favicon: '🌐',
                            isLoading: false,
                        };
                        state.browserHistory.tabs.push(newTab);
                        state.browserHistory.activeTabId = newTab.id;
                        updateBrowserTabs(windowId);
                        // Обновляем контент
                        if (contentEl) {
                            contentEl.innerHTML = renderIframe('');
                        }
                        if (urlInput) {
                            urlInput.value = '';
                        }
                        if (statusEl) {
                            statusEl.textContent = 'Готово';
                        }
                    });
                }

                // Закрытие вкладок
                document.querySelectorAll('.tab-close').forEach(el => {
                    el.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const tabId = parseInt(el.dataset.tabId);
                        if (state.browserHistory.tabs.length <= 1) {
                            // Не закрываем последнюю вкладку
                            return;
                        }
                        const index = state.browserHistory.tabs.findIndex(t => t.id === tabId);
                        if (index !== -1) {
                            state.browserHistory.tabs.splice(index, 1);
                            if (state.browserHistory.activeTabId === tabId) {
                                state.browserHistory.activeTabId = state.browserHistory.tabs[Math.min(index,
                                    state.browserHistory.tabs.length - 1)].id;
                            }
                            updateBrowserTabs(windowId);
                            // Обновляем контент
                            const activeTab = state.browserHistory.tabs.find(t => t.id === state.browserHistory
                                .activeTabId);
                            if (activeTab && contentEl) {
                                contentEl.innerHTML = renderIframe(activeTab.url || '');
                                if (urlInput) {
                                    urlInput.value = activeTab.url || '';
                                }
                            }
                        }
                    });
                });

                // Переключение вкладок
                document.querySelectorAll('.browser-tab').forEach(el => {
                    el.addEventListener('click', (e) => {
                        if (e.target.classList.contains('tab-close')) return;
                        const tabId = parseInt(el.dataset.tabId);
                        state.browserHistory.activeTabId = tabId;
                        const activeTab = state.browserHistory.tabs.find(t => t.id === tabId);
                        if (activeTab && contentEl) {
                            contentEl.innerHTML = renderIframe(activeTab.url || '');
                            if (urlInput) {
                                urlInput.value = activeTab.url || '';
                            }
                            if (statusEl) {
                                statusEl.textContent = 'Готово';
                            }
                        }
                        updateBrowserTabs(windowId);
                    });
                });

                // Обновляем статус
                setInterval(() => {
                    const timeEl = document.getElementById('browserTime');
                    if (timeEl) {
                        timeEl.textContent = new Date().toLocaleTimeString();
                    }
                }, 10000);
            }

            function updateBrowserTabs(windowId) {
                const winData = state.windows.find(w => w.id === windowId);
                if (!winData) return;

                const tabsContainer = winData.element.querySelector('.browser-tabs');
                if (!tabsContainer) return;

                const newTabBtn = tabsContainer.querySelector('#newTabBtn');

                let tabsHTML = '';
                state.browserHistory.tabs.forEach(tab => {
                    const isActive = tab.id === state.browserHistory.activeTabId;
                    const loadingClass = tab.isLoading ? 'tab-loading' : '';
                    tabsHTML += `
                        <div class="browser-tab ${isActive ? 'active' : ''}" data-tab-id="${tab.id}">
                            <span class="tab-favicon ${loadingClass}">${tab.isLoading ? '⟳' : (tab.favicon || '🌐')}</span>
                            <span>${tab.title || 'Новая вкладка'}</span>
                            <span class="tab-close" data-tab-id="${tab.id}">✕</span>
                        </div>
                    `;
                });

                tabsContainer.innerHTML = tabsHTML + (newTabBtn ? newTabBtn.outerHTML :
                    '<button id="newTabBtn" style="background:rgba(255,255,255,0.05); border:1px solid #2a4060; color:#b0caf0; border-radius:8px; padding:2px 12px; cursor:pointer; font-size:16px;">+</button>'
                    );

                setTimeout(() => {
                    setupBrowserEvents(windowId);
                }, 50);
            }

            // ----- МЕНЮ ПУСК -----
            function toggleStartMenu() {
                if (state.isLocked) return;
                state.startMenuOpen = !state.startMenuOpen;
                startMenu.classList.toggle('visible', state.startMenuOpen);
            }

            function closeStartMenu() {
                state.startMenuOpen = false;
                startMenu.classList.remove('visible');
            }

            // ----- СОБЫТИЯ -----
            startBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                toggleStartMenu();
            });

            document.querySelectorAll('.start-app-item[data-app]').forEach(el => {
                el.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const app = el.dataset.app;
                    if (app) launchApp(app);
                });
            });

            document.getElementById('shutdown-item').addEventListener('click', () => {
                if (confirm('Выключить систему?')) {
                    document.body.innerHTML = `
                        <div style="display:flex; height:100vh; justify-content:center; align-items:center; background:#0a0e18; color:#b8d4ff; flex-direction:column; gap:30px;">
                            <span style="font-size:70px;">⏻</span>
                            <h1 style="font-weight:300;">Система выключена</h1>
                            <p style="opacity:0.6;">Нажмите F5 или перезагрузите страницу</p>
                        </div>
                    `;
                }
            });

            document.querySelectorAll('.desktop-icon').forEach(icon => {
                icon.addEventListener('dblclick', () => {
                    const app = icon.dataset.app;
                    if (app) launchApp(app);
                });
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('#start-menu') && !e.target.closest('#start-btn')) {
                    closeStartMenu();
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeStartMenu();
                if (e.ctrlKey && e.key === 'l') {
                    e.preventDefault();
                    if (!state.isLocked && state.bootComplete) lockSystem();
                }
                if (state.isLocked) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        checkPassword();
                    }
                    return;
                }
                if (e.altKey && e.key === 'n') { e.preventDefault();
                    launchApp('notepad'); }
                if (e.altKey && e.key === 'a') { e.preventDefault();
                    launchApp('about'); }
                if (e.altKey && e.key === 'e') { e.preventDefault();
                    launchApp('explorer'); }
                if (e.altKey && e.key === 't') { e.preventDefault();
                    launchApp('terminal'); }
                if (e.altKey && e.key === 'm') { e.preventDefault();
                    launchApp('taskmgr'); }
                if (e.altKey && e.key === 'c') { e.preventDefault();
                    launchApp('mycomputer'); }
                if (e.altKey && e.key === 'r') { e.preventDefault();
                    launchApp('regedit'); }
                if (e.altKey && e.key === 'b') { e.preventDefault();
                    launchApp('browser'); }
            });

            document.addEventListener('dragstart', (e) => e.preventDefault());

            // ----- ЭКСПОРТ -----
            window.launchApp = launchApp;
            window.lockSystem = lockSystem;
            window.navigateTo = function(url) {
                const browserWin = state.windows.find(w => w.app === 'browser');
                if (browserWin) {
                    const urlInput = document.getElementById('browserUrl');
                    if (urlInput) {
                        urlInput.value = url;
                        const goBtn = document.getElementById('goBtn');
                        if (goBtn) goBtn.click();
                    }
                }
            };

            // После завершения загрузки отмечаем, что система готова
            setTimeout(() => {
                const checkComplete = setInterval(() => {
                    if (bootScreen.classList.contains('hidden')) {
                        state.bootComplete = true;
                        clearInterval(checkComplete);
                    }
                }, 100);
            }, 100);

        })();
    </script>

</body>
</html>
